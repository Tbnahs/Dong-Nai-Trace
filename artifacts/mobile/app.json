{
  "expo": {
    "name": "Đồng Nai Trace (Portal)-mobile",
    "slug": "ngnaitraceportalmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ngnaitraceportalmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2740BA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ngnaitraceportalmobile.app"
    },
    "android": {
      "package": "com.ngnaitraceportalmobile.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Đồng Nai Trace sử dụng camera để quét mã QR và mã vạch."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}