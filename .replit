modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mobile: expo"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
LOG_LEVEL = "info"
NODE_ENV = "development"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/khanh-hoa-trace: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/khanh-hoa-trace-mobile: expo"

[[workflows.workflow]]
name = "artifacts/khanh-hoa-trace: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=24671 BASE_PATH=/khanh-hoa-trace/ pnpm --filter @workspace/khanh-hoa-trace run dev"
waitForPort = 24671

[[workflows.workflow]]
name = "artifacts/khanh-hoa-trace-mobile: expo"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=18839 pnpm --filter @workspace/khanh-hoa-trace-mobile run dev"
waitForPort = 18839
